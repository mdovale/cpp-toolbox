BasedOnStyle: LLVM
Language: Cpp
Standard: c++20
ColumnLimit: 80
IndentWidth: 2
PointerAlignment: Left
AlwaysBreakTemplateDeclarations: Yes
AllowShortFunctionsOnASingleLine: Inline
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<toolbox/'
    Priority: 3
  - Regex: '^<catch2/'
    Priority: 2
  - Regex: '^<'
    Priority: 1
  - Regex: '.*'
    Priority: 4
